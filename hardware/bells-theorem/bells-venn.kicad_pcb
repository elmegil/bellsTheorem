  (gr_text "This side for\n5V rack power" (at 256.8702 120.8532) (layer "B.SilkS") (tstamp 14037773-abdf-4f4d-a086-0f786a2e0f16)
    (effects (font (size 0.635 0.635) (thickness 0.15)) (justify mirror))
  )
  (gr_text "Thanks to Nyles Miszczyk for\nthe inspiration to make this\nAnd Jim Matheson for much \nhelp with Teensy Interfacing" (at 266.7254 115.2398) (layer "B.SilkS") (tstamp 19255830-03be-4aca-880c-0f68e7ccf512)
    (effects (font (size 0.889 0.889) (thickness 0.1905)) (justify mirror))
  )
  (gr_text "P2\n" (at 136.906 64.7446) (layer "B.SilkS") (tstamp 253d37bc-ec0c-4cd2-a352-d2159dc01cf0)
