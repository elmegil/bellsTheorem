  )
  (gr_text "P6" (at 156.1846 51.4858) (layer "B.SilkS") (tstamp 28fca10d-ad5b-4556-861b-a7595b1007d0)
    (effects (font (size 1.5 1.5) (thickness 0.3)) (justify mirror))
  )
  (gr_text "Options: \n- use 16 pin Euro header and take 5V\n  from the rack. In this case omit \n  the RECOM, C2 is 10uF\n- use 10 pin Euro Header and RECOM \n  regulator for 5V. In this case add\n  the RECOM, C2 is 1uF\nJumper J24 to select\n" (at 274.9296 130.1242) (layer "B.SilkS") (tstamp 400c7a12-6a3b-4007-bebb-25fa9d8ef61f)
    (effects (font (size 0.635 0.635) (thickness 0.15)) (justify left mirror))
  )
  (gr_text "A" (at 94.488 104.14) (layer "B.SilkS") (tstamp 4978a171-a407-46ca-af53-8ee0deb5d339)
