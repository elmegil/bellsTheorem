    (effects (font (size 1.5 1.5) (thickness 0.254)) (justify mirror))
  )
  (gr_text "This is pin 1 whether \nusing 10 pin or 16 pin header" (at 206.9084 129.1844) (layer "B.SilkS") (tstamp 522dff87-8907-4e19-9947-3268606b3128)
    (effects (font (size 0.635 0.635) (thickness 0.15)) (justify mirror))
  )
